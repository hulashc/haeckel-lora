# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
env/

# scraping scratch space (the zip is deleted after extraction anyway)
data/raw/_download/

# Jupyter
.ipynb_checkpoints/

# Data & model weights (large binaries — not tracked)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# ...except small, hand-verified metadata that's expensive to regenerate (plate captions were
# transcribed visually, not scraped) and costs nothing to keep in git.
!data/processed/plate_index.csv
!data/processed/plate_details.json
!data/processed/README.md
outputs/checkpoints/*
outputs/samples/*
!outputs/checkpoints/.gitkeep
!outputs/samples/.gitkeep
*.safetensors
*.ckpt
*.pt
*.pth

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Env / secrets
.env
